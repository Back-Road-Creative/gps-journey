# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_PHOTOS__CLIENT_ID=
GOOGLE_PHOTOS__CLIENT_SECRET=
GOOGLE_PHOTOS__PROJECT_ID=

# Private inputs directory (config.yaml, location overrides); default ./inputs
# GPS_INPUTS_DIR=/path/to/your/inputs

# Optional: Override default paths
# GOOGLE_PHOTOS__CREDENTIALS_PATH=credentials.json
# GOOGLE_PHOTOS__TOKEN_PATH=token.json

# Geocoding, Processing and Logging settings below are reserved: they are loaded
# into Config but not yet read by any command.
# Geocoding Configuration
# GEOCODING__PROVIDER=nominatim
# GEOCODING__RATE_LIMIT=1.0
# GEOCODING__CACHE_ENABLED=true
# GEOCODING__NOMINATIM_USER_AGENT=gps-journey/0.1.0

# Google Maps API (optional, for enhanced geocoding)
# GEOCODING__GOOGLE_API_KEY=

# Hugo Integration Paths (no defaults; point these at your own Hugo site)
# A HUGO__ value here wins over an exported HUGO_ variable; export HUGO__CONTENT_PATH
# (or pass --hugo-dir) to override it.
# HUGO__CONTENT_PATH=./content/journeys
# The next three are reserved: not read by any command yet (--static-dir is the
# only way to give the generator a static directory).
# HUGO__STATIC_PATH=./static
# HUGO__IMAGE_PATH=./static/images/journeys
# HUGO__MAP_PATH=./static/maps

# Processing Settings
# PROCESSING__MIN_STOP_DURATION_SECONDS=300
# PROCESSING__PHOTO_MATCH_TOLERANCE_SECONDS=300
# PROCESSING__WAYPOINT_DISTANCE_THRESHOLD_METERS=100

# Logging
# LOG_LEVEL=INFO

# Optional: record generate_narrative.py output in an IntelDB SQLite database.
# Off unless both INTEL_DB_PATH and INTEL_SCRIPTS_DIR are set (the directory must
# contain intel_db.py defining IntelDB). Read from the environment only.
# INTEL_DB_PATH=
# INTEL_SCRIPTS_DIR=
# Platform label stored with each run. Earlier versions of the script recorded
# "gomoveshift-gps"; set that value to keep new runs grouped with that history.
# INTEL_PLATFORM=gps-journey
